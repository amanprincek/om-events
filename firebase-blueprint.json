      "description": "Active cleaning, repairs and restoration tasks tracking logs"
    },
    "menus": {
      "schema": "Menu",
      "description": "Catering blueprints and customized dish schedules"
    },
    "gallery_albums": {
      "schema": "GalleryAlbum",
      "description": "Exquisite showcase event collection groupings for high-visibility guest portfolios"
    },
    "gallery_media": {
      "schema": "GalleryMedia",
      "description": "Photos and drone videos depicting royal setups"
    },
    "staff": {
      "schema": "StaffMember",
      "description": "Operational employee lists and RBAC settings"
    },
    "inquiries": {
      "schema": "Inquiry",
      "description": "Incoming leads and service reservation requests"
    }
  }
}
